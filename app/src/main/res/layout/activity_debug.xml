<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView android:text="Registers" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvRegisters" android:fontFamily="monospace" android:textSize="12sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <TextView android:text="Breakpoint address (hex)" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <EditText android:id="@+id/etBreakpoint" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="e.g. 00000100"/>
            <Button android:id="@+id/btnAddBp" android:text="Add" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/btnClearBp" android:text="Clear" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView android:text="Memory (hex dump from PC)" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvMemory" android:fontFamily="monospace" android:textSize="10sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <TextView android:text="Trace log (most recent)" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvTrace" android:fontFamily="monospace" android:textSize="10sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <Button android:id="@+id/btnRefresh" android:text="Refresh" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
