<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:text="Hardware Profile" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Spinner android:id="@+id/spinnerProfiles" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tvProfileDetail" android:layout_marginTop="16dp" android:fontFamily="monospace"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:text="Memory Map" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/tvMemMap" android:fontFamily="monospace" android:textSize="12sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

</LinearLayout>
